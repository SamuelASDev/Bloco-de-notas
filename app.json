{
  "expo": {
    "name": "bloco-de-notas",
    "slug": "bloco-de-notas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bloco.png",
    "scheme": "blocodenotas",
    "userInterfaceStyle": "automatic",
    "androidNavigationBar": {
      "backgroundColor": "#1E1E1E",
      "barStyle": "light"
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bloco.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.samueltonis.blocodenotas"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-edge-to-edge",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31ecb570-d4fc-464f-9b0d-fd85e5647524"
      }
    }
  }
}
