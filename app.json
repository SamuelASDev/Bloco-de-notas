{
  "expo": {
    "name": "bloco-de-notas",
    "slug": "bloco-de-notas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bloco.png",
    "scheme": "blocodenotas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bloco.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.samueltonis.blocodenotas"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-edge-to-edge",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/plain"],
            "multipleShareMimeTypes": []
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickNote",
              "label": "Nota rápida",
              "description": "Crie uma nota ou checklist com um toque.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31ecb570-d4fc-464f-9b0d-fd85e5647524"
      }
    }
  }
}
